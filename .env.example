# ==============================
# LEBUX BACKEND - VARIÁVEIS DE AMBIENTE
# ==============================
# Copie este arquivo para .env e preencha

# Supabase (https://supabase.com)
SUPABASE_URL=https://your-project-ref.supabase.co/rest/v1/
SUPABASE_SERVICE_KEY=sb_secret_REPLACE_ME

# JWT (gere uma senha forte)
JWT_SECRET=YOUR_JWT_SECRET

# Porta (Render usa automaticamente)
PORT=3001

# URL do frontend (para CORS)
FRONTEND_URL=https://lebux.vercel.app

# SMTP para envio de e-mail de redefinição de senha
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_FROM="Lebux <no-reply@lebux.com>"

# Seed seguro para usuários demo (desativado por padrão)
ENABLE_DEMO_SEED=false
DEMO_ADMIN_EMAIL=admin@example.com
DEMO_ADMIN_PASSWORD=ChangeMe123!
DEMO_ADMIN_NAME=Admin Lebux
DEMO_COMPANY_EMAIL=company@example.com
DEMO_COMPANY_PASSWORD=ChangeMe123!
DEMO_COMPANY_NAME=Barbearia do Leonardo
